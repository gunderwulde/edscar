{
  "name": "edscar",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tests/verification/tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint --max-warnings=0 .",
    "check-third-party": "node scripts/check-third-party.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  }
}
